---
import '../styles/global.css';
import { content } from '../lib/content';

interface Props {
  title: string;
  description: string;
  /**
   * The scene's grid geometry, set on `.shell` rather than on the playfield.
   * One chassis width (DESIGN §2 v2.1) means the HUD, the field and the bottom
   * bezel are all sized from `--cols` × `--cell` — so the columns and rows have
   * to be visible to all three, which makes their common ancestor the only place
   * they can live.
   */
  geometry: Record<string, string>;
}

const { title, description, geometry } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://aix4u.com');
const ogImage = new URL('/og.png', canonical);
const site = (Astro.site ?? new URL('https://aix4u.com')).origin;

/**
 * Entity linking (DESIGN §12.5 v2.1.4): https://kshift.me/#person is the
 * single Person source of truth. Its `url` points to kshift.me and `sameAs`
 * contains only the X and GitHub profiles. The aix4u WebSite and products
 * reference that Person through `creator`; aix4u is a collection of work,
 * not an equivalent page for the Person. check:links asserts this contract.
 */
const KSHIFT_PERSON_ID = 'https://kshift.me/#person';
const KSHIFT_PROFILE_URL = 'https://kshift.me/';
const KSHIFT_SAME_AS = ['https://x.com/kshift', 'https://github.com/RuochenLyu'] as const;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'aix4u',
      description,
      creator: { '@id': KSHIFT_PERSON_ID },
    },
    {
      '@type': 'Person',
      '@id': KSHIFT_PERSON_ID,
      name: 'kshift',
      url: KSHIFT_PROFILE_URL,
      image: 'https://kshift.me/assets/avatar-day.jpg',
      sameAs: [...KSHIFT_SAME_AS],
    },
    {
      '@type': 'ItemList',
      name: 'Products by kshift',
      description,
      url: canonical.href,
      numberOfItems: content.products.length,
      itemListElement: content.products.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: product.name,
          url: product.url,
          description: product.description,
          applicationCategory: 'WebApplication',
          creator: { '@id': KSHIFT_PERSON_ID },
        },
      })),
    },
  ],
};

/**
 * Skin preloads (DESIGN §12.4 v2.1.4): the theme is resolved before first
 * paint by the inline script below, which then injects `<link rel="preload"
 * as="image">` for exactly the active theme's PNGs — a static tag pair would
 * double-fetch. The same script keeps `theme-color` in step with the chassis.
 */
const skins = {
  light: content.products.map((product) => product.skin.light).filter(Boolean),
  dark: content.products.map((product) => product.skin.dark).filter(Boolean),
};
const themeColors = { light: '#c9d2dd', dark: '#141519' };
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content="kshift" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColors.light} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aix4u" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="preload" href="/fonts/silkscreen-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline define:vars={{ skins, themeColors }}>
      // Resolve the theme before first paint: `?theme=` (a debug/share override
      // in the same spirit as `?seed=`, not persisted) wins, then the stored
      // choice, then the OS. Also flips `no-js` to `js` so the CSS knows the
      // engine is coming — and, now that the theme is known, preloads exactly
      // the active theme's skins and points `theme-color` at its chassis
      // (DESIGN §12.4, §12.6 v2.1.4).
      (() => {
        const root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('js');
        let theme = new URLSearchParams(location.search).get('theme');
        if (theme !== 'light' && theme !== 'dark') {
          try {
            theme = localStorage.getItem('aix4u-theme');
          } catch {}
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme]);
        for (const href of skins[theme]) {
          const link = document.createElement('link');
          link.rel = 'preload';
          link.as = 'image';
          link.href = href;
          document.head.appendChild(link);
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="ambience" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="shell" id="shell" style={geometry}>
      <slot />
    </div>
  </body>
</html>
