---
import Base from '../layouts/Base.astro';
import Hud from '../components/Hud.astro';
import Playfield from '../components/Playfield.astro';
import InfoPanel from '../components/InfoPanel.astro';

const title = 'aix4u — products by Ruochen';
const description =
  'Indie products by Ruochen — daily puzzles, idea feeds, open data and developer tools. aix4u = AI for you.';
---

<Base title={title} description={description}>
  <Hud />

  <main class="stage">
    <h1 class="visually-hidden">{title}</h1>
    <Playfield />
  </main>

  <InfoPanel />

  <footer class="hint">
    <span class="hint__chevrons hint__chevrons--in" aria-hidden="true">&gt;&gt;&gt;</span>
    <button type="button" class="hint__button" id="reshuffle">
      <span class="hint__fine">press <span class="hint__key">R</span> to reshuffle</span>
      <span class="hint__coarse">tap to reshuffle</span>
    </button>
    <span class="hint__chevrons hint__chevrons--out" aria-hidden="true">&lt;&lt;&lt;</span>
  </footer>
</Base>

<script>
  import '../scripts/main';
</script>
