---
import Base from '../layouts/Base.astro';
import Hud from '../components/Hud.astro';
import Playfield from '../components/Playfield.astro';
import InfoPanel from '../components/InfoPanel.astro';
import { content } from '../lib/content';
import { buildScene, DEFAULT_SEED, DEFAULT_VIEWPORT } from '../lib/scene';

const title = 'aix4u — products by Ruochen';
const description =
  'Indie products by Ruochen — daily puzzles, idea feeds, open data and developer tools. aix4u = AI for you.';

// The build-time frame uses the widest breakpoint and a fixed seed, so the static
// HTML is a complete, readable scene even with scripting disabled. The client runs
// the same function, so `?seed=20260729` on a wide viewport reproduces this frame.
//
// The scene is built here, not inside the playfield, because its grid geometry now
// sizes the whole chassis (DESIGN §2 v2.1), not just the field.
const scene = buildScene(DEFAULT_SEED, DEFAULT_VIEWPORT, content.items);
const geometry = {
  '--cols': String(scene.breakpoint.cols),
  '--rows': String(scene.breakpoint.rows),
};
---

<Base title={title} description={description} geometry={geometry}>
  <Hud />

  <main class="stage">
    <h1 class="visually-hidden">{title}</h1>
    <Playfield scene={scene} />
  </main>

  <InfoPanel />
</Base>

<script>
  import '../scripts/main';
</script>
