---
import PixelLogo from './PixelLogo.astro';
import type { SceneItem } from '../lib/content';
import { crossDirection, type PiecePlacement } from '../lib/scene';
import { SHAPES } from '../lib/tetromino';

interface Props {
  item: SceneItem;
  placement: PiecePlacement;
}

const { item, placement } = Astro.props;
const shape = SHAPES[placement.shape];
const isProduct = item.type === 'product';
const label = placement.label;

const style: Record<string, string> = {
  '--gx': String(placement.x),
  '--gy': String(placement.y),
  '--pw': String(shape.width),
  '--ph': String(shape.height),
  '--order': String(placement.order),
  '--fall-delay': `${placement.order * 80}ms`,
  '--fall-duration': '560ms',
  '--bob-period': `${placement.bobPeriod || 6}s`,
  '--bob-delay': `${placement.bobDelay}s`,
};

if (item.type === 'product') {
  style['--accent'] = item.accent;
  style['--accent-dark'] = item.accentDark;
}

// The card carries its piece's accent too: in dark mode the card is lit in that
// colour, which is what ties it to its tetromino when the leader is short.
const labelStyle = label
  ? {
      ...(item.type === 'product' ? { '--accent': item.accent, '--accent-dark': item.accentDark } : {}),
      '--gx': String(label.x),
      '--gy': String(label.y),
      '--lw': String(label.w),
      '--lh': String(label.h),
      '--leader': String(label.leader),
      '--cross': String(label.crossAbs),
      '--fall-delay': `${placement.order * 80}ms`,
      '--fall-duration': '560ms',
    }
  : undefined;
---

<a
  class:list={[
    'piece',
    isProduct ? 'piece--product' : 'piece--link',
    placement.pool === 'floating' ? 'piece--floating' : 'piece--landed',
  ]}
  id={`piece-${item.id}`}
  data-piece={item.id}
  data-pool={placement.pool}
  data-name={item.name}
  href={item.url}
  rel={isProduct ? 'noopener' : 'me noopener'}
  title={isProduct ? undefined : item.name}
  aria-label={isProduct ? undefined : item.name}
  style={style}
>
  <span class="piece__drop">
    {/* Motion-trail ticks hang above the piece while it falls (DESIGN §5.1). */}
    <span class="piece__trail" aria-hidden="true"></span>
    <span class="piece__bob">
      <span class="piece__lift">
        <span class="piece__body">
          {
            shape.cells.map(([cx, cy], index) => (
              <span
                class:list={['cell', index === shape.icon && 'cell--icon']}
                style={{ '--cx': String(cx), '--cy': String(cy) }}
                aria-hidden="true"
              >
                {
                  index === shape.icon &&
                    (item.icon ? (
                      <img class="cell__art" src={item.icon} alt="" width="24" height="24" loading="eager" />
                    ) : item.type === 'link' && item.logo ? (
                      <PixelLogo logo={item.logo} />
                    ) : (
                      <span class="cell__glyph">{isProduct ? item.name.charAt(0) : item.label}</span>
                    ))
                }
              </span>
            ))
          }
        </span>
      </span>
    </span>
  </span>
  <span class="visually-hidden">
    {item.name}{item.type === 'product' ? ` — ${item.tagline}` : ''}
  </span>
</a>

{
  label && item.type === 'product' && (
    <div
      class:list={['label', label.compact && 'label--compact']}
      data-label={item.id}
      data-side={label.side}
      data-cross={crossDirection(label.cross)}
      data-connected={String(label.connected)}
      style={labelStyle}
      aria-hidden="true"
    >
      <span class="label__leader"></span>
      <span class="label__name">{item.name}</span>
      <span class="label__tagline">{item.tagline}</span>
    </div>
  )
}
