---
/**
 * Every piece is an off-site link, so every piece carries the link policy
 * (DESIGN §4.15): a new tab, `noopener noreferrer`, and — for products — a
 * descriptive `title` built from the name and the tagline, on top of the sr-only
 * text. The band used to say the name in the markup; the title is what replaces
 * it for a hovering visitor and for anything reading anchors.
 *
 * One tetromino = one product (DESIGN §3). Three layers, back to front: the skin
 * (an art asset, or the accent-fill placeholder until one lands), the CSS cells
 * with their silhouette seam, bevel and extruded bottom edge, and the eye. v2.1
 * retired the fourth — the sticker name band (§3.2).
 *
 * The nesting of the transform layers is load-bearing. Each animation owns one
 * element so they compose instead of fighting over a single `transform`:
 *   drop   the gravity fall / hard drop
 *   spin   the personality moves that happen *while* falling (T's tease
 *          rotation, S's sway)
 *   bob    the idle breathing / metronome tick
 *   lift   hover and press
 *   body   the landing squash, and the cast shadow
 */
import PixelLogo from './PixelLogo.astro';
import { MOTION_PRESETS, panelLine, type SceneItem } from '../lib/content';
import type { PiecePlacement } from '../lib/scene';
import { SHAPES, edgesOf } from '../lib/tetromino';

interface Props {
  item: SceneItem;
  placement: PiecePlacement;
}

const { item, placement } = Astro.props;
const shape = SHAPES[placement.shape];
const isProduct = item.type === 'product';

const motion = isProduct ? MOTION_PRESETS[item.motion] : MOTION_PRESETS['squash'];

/**
 * Per-cell silhouette flags, resolved at build time. The CSS draws the seam only
 * on edges that face the outside world (the skins bake their own interior grid,
 * §3.1 v2.1) and hangs the extruded edge off the bottom silhouette (§2 v2.1).
 * `1`/`0` rather than presence/absence of an attribute, because the CSS reads
 * them as numbers in a calc().
 */
const cells = shape.cells.map(([cx, cy]) => {
  const edges = edgesOf(shape, cx, cy);
  return {
    cx,
    cy,
    style: {
      '--cx': String(cx),
      '--cy': String(cy),
      '--e-top': edges.top ? '1' : '0',
      '--e-right': edges.right ? '1' : '0',
      '--e-bottom': edges.bottom ? '1' : '0',
      '--e-left': edges.left ? '1' : '0',
    },
  };
});

const style: Record<string, string> = {
  '--gx': String(placement.x),
  '--gy': String(placement.y),
  '--pw': String(shape.width),
  '--ph': String(shape.height),
  '--order': String(placement.order),
  '--fall-delay': `${placement.order * 80}ms`,
  '--fall-duration': '560ms',
  '--bob-period': `${motion.beat === 'metronome' ? 2.6 : placement.bobPeriod || 6}s`,
  '--bob-delay': `${placement.bobDelay}s`,
  '--blink-period': `${placement.blinkPeriod}s`,
  '--blink-delay': `${placement.blinkDelay}s`,
  '--m-tease': `${motion.tease}deg`,
  '--m-prop': `${motion.prop}px`,
  '--m-sway': `${motion.sway}px`,
  '--m-squash': String(motion.squash),
  '--m-bob': `${motion.bob}px`,
};

if (item.type === 'product') {
  style['--accent'] = item.accent;
  style['--accent-dark'] = item.accentDark;
  style['--skin-light'] = item.skin.light ? `url("${item.skin.light}")` : 'none';
  style['--skin-dark'] = item.skin.dark ? `url("${item.skin.dark}")` : 'none';
  style['--eye-x'] = String(item.eye.cx + item.eye.ax);
  style['--eye-y'] = String(item.eye.cy + item.eye.ay);
  style['--badge-x'] = String(item.iconAt.cx + item.iconAt.ax);
  style['--badge-y'] = String(item.iconAt.cy + item.iconAt.ay);
}

const skinned = isProduct && Boolean(item.skin.light || item.skin.dark);
---

<a
  class:list={[
    'piece',
    isProduct ? 'piece--product' : 'piece--link',
    placement.pool === 'floating' ? 'piece--floating' : 'piece--landed',
    skinned && 'piece--skinned',
  ]}
  id={`piece-${item.id}`}
  data-piece={item.id}
  data-pool={placement.pool}
  data-shape={placement.shape}
  data-name={item.name}
  data-motion={isProduct ? item.motion : 'squash'}
  data-beat={motion.beat}
  data-panel={isProduct ? panelLine(item) : undefined}
  href={item.url}
  target="_blank"
  rel={isProduct ? 'noopener noreferrer' : 'me noopener noreferrer'}
  title={isProduct ? `${item.name} — ${item.tagline}` : item.name}
  aria-label={isProduct ? undefined : item.name}
  style={style}
>
  <span class="piece__drop">
    {/* Motion-trail ticks hang above the piece while it falls (DESIGN §6.1). */}
    <span class="piece__trail" aria-hidden="true"></span>
    {/* Landing sparks: four pixel plus-glyphs, one shot, gone (DESIGN §6.1). */}
    <span class="piece__sparks" aria-hidden="true">
      <span class="spark"></span>
      <span class="spark"></span>
      <span class="spark"></span>
      <span class="spark"></span>
    </span>
    <span class="piece__spin">
      <span class="piece__bob">
        <span class="piece__lift">
          <span class="piece__body">
            {isProduct && <span class="piece__skin" aria-hidden="true"></span>}
            {
              cells.map((cell) => (
                <span
                  class="cell"
                  data-cx={String(cell.cx)}
                  data-cy={String(cell.cy)}
                  style={cell.style}
                  aria-hidden="true"
                />
              ))
            }

            {
              /* Placeholder garnish: one pixel badge. A real skin carries its own
                 art, so the badge steps aside. */
              isProduct && !skinned && item.icon && (
                <span class="piece__badge" aria-hidden="true">
                  <img src={item.icon} alt="" width="24" height="24" loading="eager" />
                </span>
              )
            }

            {
              /* Link tiles are a single cell with a centred glyph. */
              !isProduct && (
                <span class="cell__mark" aria-hidden="true">
                  {item.icon ? (
                    <img class="cell__art" src={item.icon} alt="" width="24" height="24" loading="eager" />
                  ) : item.logo ? (
                    <PixelLogo logo={item.logo} />
                  ) : (
                    <span class="cell__glyph">{item.label}</span>
                  )}
                </span>
              )
            }

            {
              isProduct && (
                <span class="eye" aria-hidden="true">
                  <span class="eye__ball"><span class="eye__pupil"></span></span>
                  <span class="eye__lash"></span>
                </span>
              )
            }
          </span>
        </span>
      </span>
    </span>
  </span>
  {/* Nothing on the piece says its name any more (DESIGN §3.2 v2.1), so the
      accessible layer carries the whole of it: name + flavour line, in the
      piece's own <a>, in the static HTML. This is what keeps SEO and a no-JS
      crawl whole now that the info panel is the only visible copy. */}
  {item.type === 'product' && <span class="visually-hidden">{`${item.name} — ${item.tagline}`}</span>}
</a>
