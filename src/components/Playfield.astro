---
import Piece from './Piece.astro';
import { content } from '../lib/content';
import type { Scene } from '../lib/scene';
import { GHOST_SHAPES, SPARE_SHAPES, markedCell } from '../lib/tetromino';

interface Props {
  /** Built in index.astro — the same geometry also sizes the HUD and the bezel. */
  scene: Scene;
}

const { scene } = Astro.props;
const placements = new Map(scene.pieces.map((piece) => [piece.id, piece]));
const ghostShape = GHOST_SHAPES[scene.ghost.shape]!;
const eggShape = SPARE_SHAPES[scene.egg.shape]!;
const eggMark = markedCell(eggShape);
---

<div
  class="playfield is-entering is-idle"
  id="playfield"
  data-seed={scene.seed}
  style={{
    '--ghost-duration': `${scene.ghost.duration}s`,
    '--ghost-delay': `${scene.ghost.delay}s`,
  }}
>
  <div class="ghost-layer" aria-hidden="true">
    <div class="ghost" id="ghost" style={{ '--gx': String(scene.ghost.x), '--gw': String(ghostShape.width) }}>
      {
        ghostShape.cells.map(([cx, cy]) => (
          <span class="cell" style={{ '--cx': String(cx), '--cy': String(cy) }} />
        ))
      }
    </div>
  </div>

  <div class="filler-layer" id="filler-layer" aria-hidden="true">
    {
      scene.filler.map((cell) => (
        <span
          class:list={['filler', cell.empty && 'filler--empty']}
          data-tone={cell.tone}
          style={{ '--gx': String(cell.x), '--gy': String(cell.y) }}
        />
      ))
    }
  </div>

  {
    /* Pieces are emitted in priority order — products first, most prominent
       first, then the link tiles — so Tab walks the scene the way the design
       ranks it (DESIGN §4.4). Stacking is z-index's job, not the DOM's. */
    content.items.map((item) => {
      const placement = placements.get(item.id);
      return placement ? <Piece item={item} placement={placement} /> : null;
    })
  }

  {/* The mystery piece: a whole tetromino in a silhouette no product uses, stood
      on the bed as the one that has not been revealed yet (DESIGN §6.5 v2.1.1).
      It is in the scene from the first frame; the third reshuffle is what makes
      it drop from the NEXT slot for real. */}
  <a
    class="egg"
    id="egg"
    href={content.next.url}
    rel="noopener noreferrer"
    target="_blank"
    title="Tell me what to build next"
    style={{
      '--gx': String(scene.egg.x),
      '--gy': String(scene.egg.y),
      '--pw': String(eggShape.width),
      '--ph': String(eggShape.height),
    }}
  >
    <span class="egg__drop">
      <span class="egg__trail" aria-hidden="true"></span>
      <span class="egg__body">
        {
          eggShape.cells.map(([cx, cy]) => (
            <span class="cell egg__cell" style={{ '--cx': String(cx), '--cy': String(cy) }} aria-hidden="true">
              {cx === eggMark[0] && cy === eggMark[1] ? '?' : ''}
            </span>
          ))
        }
      </span>
    </span>
    <span class="visually-hidden">Tell me what to build next</span>
  </a>

  {/* Pixel selection brackets, parked off-scene until something is selected. */}
  <div class="cursor" id="cursor" aria-hidden="true" hidden>
    <span class="cursor__corner"></span>
    <span class="cursor__corner"></span>
    <span class="cursor__corner"></span>
    <span class="cursor__corner"></span>
  </div>

  {/* One row of white light, walked up the settled stack row by row during a
      line clear (DESIGN §6.3 v2.1). */}
  <div class="scan" id="scan" aria-hidden="true"></div>
</div>
