---
import Piece from './Piece.astro';
import { content } from '../lib/content';
import { buildScene, DEFAULT_SEED, DEFAULT_VIEWPORT } from '../lib/scene';
import { SHAPES } from '../lib/tetromino';

// The build-time frame uses the widest breakpoint and a fixed seed, so the
// static HTML is a complete, readable scene even with scripting disabled. The
// client runs the same function, so `?seed=20260729` on a wide viewport
// reproduces this exact frame.
const scene = buildScene(DEFAULT_SEED, DEFAULT_VIEWPORT, content.items);
const placements = new Map(scene.pieces.map((piece) => [piece.id, piece]));
const ghostShape = SHAPES[scene.ghost.shape];
---

<div
  class="playfield is-entering is-idle"
  id="playfield"
  data-seed={scene.seed}
  style={{
    '--cols': String(scene.breakpoint.cols),
    '--rows': String(scene.breakpoint.rows),
    '--stack-rows': String(scene.breakpoint.stackRows),
    '--ghost-duration': `${scene.ghost.duration}s`,
    '--ghost-delay': `${scene.ghost.delay}s`,
  }}
>
  <div class="ghost-layer" aria-hidden="true">
    <div class="ghost" id="ghost" style={{ '--gx': String(scene.ghost.x) }}>
      {
        ghostShape.cells.map(([cx, cy]) => (
          <span class="cell" style={{ '--cx': String(cx), '--cy': String(cy) }} />
        ))
      }
    </div>
  </div>

  <div class="filler-layer" id="filler-layer" aria-hidden="true">
    {
      scene.filler.map((cell) => (
        <span
          class:list={['filler', cell.empty && 'filler--empty']}
          data-tone={cell.tone}
          style={{ '--gx': String(cell.x), '--gy': String(cell.y) }}
        />
      ))
    }
  </div>

  {
    /* Pieces are emitted in priority order — products first, most prominent
       first, then the link tiles — so Tab walks the scene the way the design
       ranks it (DESIGN §4.4). Stacking is z-index's job, not the DOM's. */
    content.items.map((item) => {
      const placement = placements.get(item.id);
      return placement ? <Piece item={item} placement={placement} /> : null;
    })
  }

  {/* The NEXT mystery block, parked until the third reshuffle (DESIGN §6.5). */}
  <a
    class="egg"
    id="egg"
    href={content.next.url}
    rel="noopener"
    target="_blank"
    hidden
    style={{ '--gx': String(scene.egg.x), '--gy': String(scene.egg.y) }}
  >
    <span class="egg__cell" aria-hidden="true">?</span>
    <span class="visually-hidden">Tell me what to build next</span>
  </a>

  {/* Pixel selection brackets, parked off-scene until something is selected. */}
  <div class="cursor" id="cursor" aria-hidden="true" hidden>
    <span class="cursor__corner"></span>
    <span class="cursor__corner"></span>
    <span class="cursor__corner"></span>
    <span class="cursor__corner"></span>
  </div>

  <div class="line-flash" id="line-flash" aria-hidden="true"></div>
</div>
