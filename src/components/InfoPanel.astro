---
/**
 * The bottom bezel: the one fixed info slot (DESIGN §4.4) plus the reshuffle key
 * legend (§2 v2.1) — everything the old label cards used to say, in a single
 * place that never moves, and the machine's button legend at its right end.
 *
 * (v2.1.2) The read-out is **two rows of fixed height**, and the height does not
 * change between the idle line and a selected product — the v2.1 panel typed the
 * whole `NAME · TYPE · STATUS — flavour` string as one line at 24 characters a
 * second, which on the device read as the page lagging rather than as a machine
 * printing. So the identity row (pixel name + two chips) lands instantly on
 * select, and only the flavour line types, four times faster.
 *
 * The `▸ PLAY` button is gone with it. A button inside a status bar is web
 * chrome; the machine already has a vocabulary for "this key does that", and it
 * is the legend sitting a few pixels to its right.
 *
 * The idle line is in the static HTML, so a no-JS visitor gets a real sentence
 * rather than an empty box.
 */
import { content } from '../lib/content';
---

<div class="panel" id="panel" data-state="idle">
  <div class="panel__screen">
    <div class="panel__readout" id="panel-readout" aria-live="polite" aria-atomic="true">
      <p class="panel__row panel__row--head">
        <span class="panel__name" id="panel-name"></span>
        <span class="panel__chip" id="panel-kind"></span>
        <span class="panel__chip" id="panel-status"></span>
      </p>
      <p class="panel__row panel__row--body">
        <span class="panel__text" id="panel-text">{content.panel.idle}</span><span
          class="panel__caret"
          aria-hidden="true"></span>
      </p>
    </div>

    {/* The CTA in the bezel's own language: a key and what it does (§4.4 v2.1.2). */}
    <span class="panel__open" id="panel-open" hidden>
      <span class="panel__open-fine"><span class="panel__key">⏎</span> OPEN</span>
      <span class="panel__open-coarse">TAP AGAIN TO OPEN</span>
    </span>

    <button type="button" class="panel__hint" id="reshuffle">
      <span class="panel__hint-fine">press <span class="panel__key">R</span> to reshuffle</span>
      <span class="panel__hint-coarse">tap to reshuffle</span>
    </button>
  </div>
</div>
