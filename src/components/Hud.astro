---
/**
 * The console bezel (DESIGN §2, §4.3).
 *
 * Near-black in both themes — it is the machine's chassis, not part of the
 * screen, so it does not invert with the theme. Inside: an outlined pixel
 * wordmark, dotted dividers between inset sections, a lime seven-segment
 * counter, the NEXT crate, and the sun/moon toggle.
 */
import { content } from '../lib/content';

const count = String(content.products.length).padStart(2, '0');
/** Unlit segments behind the live digits — what an LCD actually looks like. */
const ghost = '8'.repeat(count.length);
const teaser = content.next.teaser.trim();
---

<header class="hud">
  <div class="hud__chassis">
    <a class="hud__logo" href="/" aria-label="aix4u home">
      <span aria-hidden="true">AIX4U</span>
    </a>

    <span class="hud__divider" aria-hidden="true"></span>

    {/* Collection framing (DESIGN §4.3): `??` says more pieces are still falling. */}
    <p class="hud__counter">
      <span class="hud__counter-word">COLLECTED</span>
      <span class="hud__digits">
        <span class="hud__digits-ghost" aria-hidden="true">{ghost}</span>
        <span class="hud__digits-value">{count}</span>
      </span>
      <span class="hud__total" aria-label="of an unannounced total">/??</span>
    </p>

    <span class="hud__divider" aria-hidden="true"></span>

    <p class="hud__next">
      <span class="hud__next-word">NEXT</span>
      {
        teaser ? (
          <span class="hud__next-teaser">{teaser}</span>
        ) : (
          /* Just the glyph: the NEXT section is already an inset box, and a box
             inside that box read as clutter on the device (DESIGN §6.5 v2.1.2). */
          <span class="hud__next-mark" aria-label="Next product: unannounced" role="img">
            ?
          </span>
        )
      }
    </p>

    <span class="hud__divider" aria-hidden="true"></span>

    <button
      type="button"
      class="theme-toggle"
      id="theme-toggle"
      aria-pressed="false"
      aria-label="Switch to dark mode"
    >
      <svg class="icon icon-sun" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
        <g fill="#f2911e">
          <rect x="7" y="0" width="2" height="3"></rect>
          <rect x="7" y="13" width="2" height="3"></rect>
          <rect x="0" y="7" width="3" height="2"></rect>
          <rect x="13" y="7" width="3" height="2"></rect>
          <rect x="2" y="2" width="2" height="2"></rect>
          <rect x="12" y="2" width="2" height="2"></rect>
          <rect x="2" y="12" width="2" height="2"></rect>
          <rect x="12" y="12" width="2" height="2"></rect>
        </g>
        <g fill="#ffc93c">
          <rect x="6" y="4" width="4" height="1"></rect>
          <rect x="5" y="5" width="6" height="1"></rect>
          <rect x="4" y="6" width="8" height="4"></rect>
          <rect x="5" y="10" width="6" height="1"></rect>
          <rect x="6" y="11" width="4" height="1"></rect>
        </g>
        <g fill="#fff3b0">
          <rect x="6" y="6" width="2" height="1"></rect>
          <rect x="5" y="7" width="2" height="1"></rect>
        </g>
      </svg>

      <svg class="icon icon-moon" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
        <g fill="#7fb2ff">
          <rect x="8" y="2" width="4" height="1"></rect>
          <rect x="7" y="3" width="5" height="1"></rect>
          <rect x="6" y="4" width="5" height="1"></rect>
          <rect x="5" y="5" width="5" height="1"></rect>
          <rect x="4" y="6" width="5" height="4"></rect>
          <rect x="5" y="10" width="5" height="1"></rect>
          <rect x="6" y="11" width="5" height="1"></rect>
          <rect x="7" y="12" width="5" height="1"></rect>
          <rect x="8" y="13" width="4" height="1"></rect>
        </g>
        <g fill="#cfe2ff">
          <rect x="5" y="6" width="2" height="1"></rect>
          <rect x="4" y="7" width="1" height="2"></rect>
        </g>
      </svg>
    </button>
  </div>
</header>
